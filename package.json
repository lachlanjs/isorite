{
  "name": "isorite-workspace",
  "private": true,
  "type": "module",
  "description": "isorite: an agentic harness for understanding. The packages are npm workspaces.",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "fixtures": "node fixtures/expected.ts",
    "bench:atlas": "node bench/atlas_layout.mjs",
    "build": "npm run build -w @isorite/app",
    "serve": "node packages/server/src/main.ts serve",
    "test:browser": "npm run test:browser -w @isorite/app",
    "model": "node packages/server/scripts/embed-model.ts",
    "bench:retrieval": "node bench/retrieval.ts",
    "package": "node scripts/package.ts",
    "package:sea": "node scripts/sea.ts",
    "eval:iso": "node scripts/eval-iso.ts",
    "eval:artifacts": "node scripts/eval-artifacts.ts",
    "build:guide": "npm run build:guide -w @isorite/app"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
