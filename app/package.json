{
  "name": "@isorite/app",
  "version": "0.1.0",
  "private": true,
  "description": "isorite's app: a SvelteKit single-page app over the engine's Api.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:tutorial": "ISORITE_TUTORIAL=1 vite build --mode tutorial && node scripts/tutorial-manifest.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:tutorial": "playwright test -c playwright.tutorial.config.ts",
    "test:tutorial:local": "playwright test -c playwright.local.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@isorite/core": "*",
    "@isorite/engine": "*",
    "@isorite/example": "*",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "dompurify": "^3.4.16",
    "katex": "^0.18.9",
    "markdown-it": "^14.3.2",
    "markdown-it-texmath": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/markdown-it": "^14.2.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
