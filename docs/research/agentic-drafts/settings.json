{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git ls-files:*)",
      "Bash(npm run check:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run fixtures:*)",
      "Bash(npm run bench:atlas:*)",
      "Bash(npm run test:browser:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc:*)",
      "Bash(npx playwright test:*)",
      "Bash(node scripts/version.ts)",
      "Bash(node packages/server/src/main.ts doctor:*)",
      "Bash(node packages/server/src/main.ts --version)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(rg:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(npm publish:*)",
      "Bash(npm login:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
